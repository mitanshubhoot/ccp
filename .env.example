# Copy to .env. Every variable is read by ccp/config.py and nowhere else.

# Postgres (docker compose up -d). The app role cannot bypass row-level security.
DATABASE_URL=postgresql://ccp_app:ccp@localhost:5432/ccp
# Admin role: used only by `ccp db migrate` and the test database factory.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/ccp

# Filesystem state: raw zone, uploads, drafts, logs.
CCP_DATA_DIR=data
# Optional default tenant for CLI commands.
# CCP_TENANT=acme

# Models (Phase 7b onward).
# ANTHROPIC_API_KEY=
CCP_TIER2_MODEL=claude-haiku-5-5
CCP_TIER3_MODEL=claude-sonnet-5-5
CCP_SECOND_READER_MODEL=claude-sonnet-5-5
CCP_JUDGE_MODEL=claude-opus-5
# CCP_INVESTIGATOR_MODEL, CCP_POLICY_MODEL, CCP_COPILOT_MODEL default to CCP_TIER3_MODEL.

# Embeddings (Phase 7b onward).
CCP_EMBED_PROVIDER=voyage
CCP_EMBED_MODEL=voyage-3-large
# VOYAGE_API_KEY=
# Set only after opting out of training in the Voyage organization settings (A-96).
# VOYAGE_TRAINING_OPT_OUT=true
# OPENAI_API_KEY=

# Retrieval feature flags (ablation).
RETRIEVAL_RERANK=1
RETRIEVAL_CONTEXTUAL=1

# Per-run budgets enforced inside LLMClient.
CCP_RUN_BUDGET_USD=0.50
CCP_RUN_BUDGET_TOKENS=60000
CCP_RUN_BUDGET_SECONDS=120

# Tracing (Langfuse Cloud). Unset = JSONL step log only.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GitHub live client (optional; fixtures are the default source).
# GITHUB_TOKEN=

# Remediation: dry-run unless 1, and even then four more gates apply.
CCP_REMEDIATION_LIVE=0
